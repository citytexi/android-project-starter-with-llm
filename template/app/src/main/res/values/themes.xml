<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme behind Compose. Colors come from StarterTheme. Light here,
         dark in values-night, so dark mode has no white window flash. -->
    <style name="Theme.Starter" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme. installSplashScreen() swaps it for postSplashScreenTheme. -->
    <style name="Theme.Starter.Splash" parent="Theme.SplashScreen">
        <!-- Light here; values-night/colors.xml overrides splash_background for dark mode. -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Draws the icon on a circle in the launcher color, like the launcher icon. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Starter</item>
    </style>
</resources>
