<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and later. domain="file" is Context.getFilesDir(). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
