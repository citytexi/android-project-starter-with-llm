# Gradle
.gradle/
.kotlin/
# Build output of the root and of every module depth (app, feature/x, core/testing/x,
# build-logic/convention). Anchored on purpose: an unanchored `build/` would also hide
# source packages such as src/main/kotlin/com/build/.
/build/
/*/build/
/*/*/build/
/*/*/*/build/

# Local configuration (SDK path, signing keys)
local.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.DS_Store

# Android (Android Studio captures, anchored like build/ above)
/captures/
/*/captures/
/*/*/captures/
/*/*/*/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
output.json
*.hprof
